# Documentation only: this file is NOT auto-loaded. Set process environment.

# ---- MT5 account / legacy Babayaga components ----
MT5_MODE=paper
ALLOW_LIVE_TRADING=false
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
MT5_SERVER_UTC_OFFSET_SECONDS=0
MT5_COMMISSION_PER_LOT=
MT5_RESEARCH_SWAP_LONG_PER_LOT_DAY=
MT5_RESEARCH_SWAP_SHORT_PER_LOT_DAY=
MT5_RESEARCH_ROLLOVER_UTC_HOUR=
MT5_RESEARCH_TRIPLE_WEEKDAY=
MT5_MAX_SPREAD_POINTS=50
MT5_DEVIATION_POINTS=20
MT5_EXIT_SLIPPAGE_POINTS=20
MT5_MAGIC=730021
MT5_SYMBOL_MAP={}
MT5_ALLOWED_SYMBOLS=XAUUSD
MT5_STATE_DIR=data/mt5-paper
MT5_AGENT_HOST=127.0.0.1
MT5_AGENT_PORT=8787
MT5_AGENT_TOKEN=
MT5_AGENT_URL=http://127.0.0.1:8787
MAX_TRADE_RISK=0.005
MAX_PORTFOLIO_RISK=0.10
MAX_MARGIN_UTILIZATION=0.50
CIRCUIT_ENABLED=true
CIRCUIT_DRAWDOWN=0.15

# ---- BBYG local tick scalper (DEMO only) ----
# MT5_MODE must be demo. The BBYG execution adapter refuses non-DEMO accounts.
BBYG_STATE_DIR=data/bbyg-demo
BBYG_MT5_SYMBOL=XAUUSD
BBYG_MT5_MAGIC=731022
BBYG_DEVIATION_POINTS=20
BBYG_MAX_SPREAD_POINTS=50
BBYG_EMERGENCY_STOP_POINTS=150
BBYG_RISK_FRACTION=0.0025
BBYG_COMMISSION_PER_LOT=0
BBYG_POLL_INTERVAL_MS=10
BBYG_REPLAY_EVERY_TICKS=2000
# false = collect ticks / replay / train / observe intents with no MT5 writes.
BBYG_DEMO_EXECUTION=false

# ---- Legacy Railway MT5 worker ----
STATE_DIR=/app/data
MT5_STRATEGY=ppo_cfd
CFD_AUTO_TRAIN=true
CFD_TRAIN_EPISODES=2000
MT5_SYMBOL=XAUUSD
MT5_TIMEFRAME=M5
MT5_HISTORY_BARS=256
MT5_POLL_SECONDS=10
MT5_MAX_BAR_AGE_SECONDS=90
MT5_SIGNAL_RISK=0.005
MT5_REQUIRE_VOLUME=false
