# Documentation only: this file is NOT auto-loaded. Set process environment.
MT5_MODE=paper
ALLOW_LIVE_TRADING=false
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
# Explicit broker-server epoch correction. 0 for UTC timestamps; JustMarkets test environment observed +03:00 => 10800.
MT5_SERVER_UTC_OFFSET_SECONDS=0
MT5_COMMISSION_PER_LOT=
# Windows: reviewed research costs in USD per lot per rollover day; no invented defaults.
MT5_RESEARCH_SWAP_LONG_PER_LOT_DAY=
MT5_RESEARCH_SWAP_SHORT_PER_LOT_DAY=
MT5_RESEARCH_ROLLOVER_UTC_HOUR=
MT5_RESEARCH_TRIPLE_WEEKDAY=
MT5_MAX_SPREAD_POINTS=50
MT5_DEVIATION_POINTS=20
MT5_EXIT_SLIPPAGE_POINTS=20
MT5_MAGIC=730021
MT5_SYMBOL_MAP={}
MT5_ALLOWED_SYMBOLS=XAUUSD
MT5_STATE_DIR=data/mt5-paper
MT5_AGENT_HOST=127.0.0.1
MT5_AGENT_PORT=8787
MT5_AGENT_TOKEN=
MT5_AGENT_URL=http://127.0.0.1:8787
# Network binding requires both PEM paths and a trusted HTTPS endpoint.
# MT5_AGENT_TLS_CERT=
# MT5_AGENT_TLS_KEY=
MAX_TRADE_RISK=0.005
MAX_PORTFOLIO_RISK=0.10
MAX_MARGIN_UTILIZATION=0.50
CIRCUIT_ENABLED=true
CIRCUIT_DRAWDOWN=0.15

# Railway MT5 worker (separate process from the Windows agent)
STATE_DIR=/app/data
MT5_STRATEGY=ppo_cfd
CFD_AUTO_TRAIN=true
CFD_TRAIN_EPISODES=2000
# Default registry: STATE_DIR/cfd/active.json. Live requires live-approved.json.
# CFD_MODEL_REGISTRY=/app/data/cfd/active.json
MT5_SYMBOL=XAUUSD
MT5_TIMEFRAME=M5
MT5_HISTORY_BARS=256
MT5_POLL_SECONDS=10
MT5_MAX_BAR_AGE_SECONDS=90
MT5_SIGNAL_RISK=0.005
# Set true on Railway only after attaching a volume at STATE_DIR.
MT5_REQUIRE_VOLUME=false
# MT5_AGENT_URL must be a remote HTTPS origin on Railway, never localhost.
# Railway volume permissions with the current Dockerfile: RAILWAY_RUN_UID=0
